      "type": "table",
      "title": "Problemas graves (Alta y Desastre)",
      "id": 1,
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "zabbix-api"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "zabbix-api"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "root_selector": "$map(result, function($v){ {\"Equipo\": $v.hosts[0].host, \"Problema\": $v.description, \"Gravedad\": $v.priority, \"Antiguedad\": ($millis() - $number($v.lastchange)*1000) > 86400000 ? $string($round(($millis() - $number($v.lastchange)*1000)/86400000)) & \" d\" : $string($round(($millis() - $number($v.lastchange)*1000)/3600000)) & \" h\"} })",
          "filters": [],
          "url": "http://zabbix-web:8080/api_jsonrpc.php",
          "url_options": {
            "method": "POST",
            "data": "{\"jsonrpc\": \"2.0\", \"method\": \"trigger.get\", \"params\": {\"output\": [\"triggerid\", \"description\", \"priority\", \"lastchange\"], \"selectHosts\": [\"host\"], \"only_true\": true, \"monitored\": true, \"sortfield\": \"priority\", \"sortorder\": \"DESC\", \"limit\": 100, \"filter\": {\"priority\": [4, 5]}}, \"id\": 1}",
            "headers": [
              {
                "key": "Content-Type",
                "value": "application/json-rpc"
              }
            ]
          },
          "columns": [
            {
              "selector": "Equipo",
              "text": "Equipo",
              "type": "string"
            },
            {
              "selector": "Problema",
              "text": "Problema",
              "type": "string"
            },
            {
              "selector": "Gravedad",
              "text": "Gravedad",
              "type": "string"
            },
            {
              "selector": "Antiguedad",
              "text": "Antiguedad",
              "type": "string"
            }
          ],
          "query": "problemas_altos_tabla"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "Equipo": 0,
              "Problema": 1,
              "Gravedad": 2,
              "Antiguedad": 3
            },
            "renameByName": {}
          }
        }
      ],
      "options": {
        "cellHeight": "sm",
