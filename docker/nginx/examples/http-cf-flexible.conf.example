# Example: plain-HTTP origin vhost behind Cloudflare Flexible.
#
# Static file, NOT a template. For sites whose TLS terminates at the
# Cloudflare edge (Flexible) while origin serves HTTP. Mount it directly,
# replacing the template (see docker-compose.cf-flexible.yml pattern):
#   volumes:
#     - ./nginx/examples/http-cf-flexible.conf.example:/etc/nginx/conf.d/default.conf:ro
# (and publish only port 80 for that run).
server {
    listen 80;
    server_name _;

    # Legacy path: native installs served under /zabbix/ (old bookmarks).
    location ~ ^/zabbix(/.*)?$ {
        return 301 $scheme://$host$1;
    }

    location / {
        proxy_pass http://zabbix-web:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
    }
}
