# Example: plain-HTTP lab vhost (no TLS).
#
# Static file, NOT a template. For local lab only, where ports 80/443
# termination is not needed. Mount it directly, replacing the template:
#   volumes:
#     - ./nginx/examples/http-only-lab.conf.example:/etc/nginx/conf.d/default.conf:ro
# (and drop the certs/webroot mounts and 443 publish for that run).
server {
    listen 80;
    server_name _;

    # Docker embedded DNS: re-resolve zabbix-web so a recreated container
    # (new IP) does not leave a stale upstream behind.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        set $upstream http://zabbix-web:8080;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
    }
}
