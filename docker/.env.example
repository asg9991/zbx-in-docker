POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CAMBIAR

TZ=America/Argentina/Cordoba
SERVER_IP=X.X.X.X

# Directorio base de datos persistentes (postgres).
# Default: /opt/monitoring/data (server). En lab local, apuntar a un directorio propio.
# DATA_DIR=/home/usuario/zbx-in-docker/data
DATA_DIR=/opt/monitoring/data
# Per-site: DATA_DIR=/opt/monitoring/data (volume hosting postgres/certs/certbot-webroot/bkp-pre-docker)

# TLS / site identity (per-site: each deployment sets its own values).
# SERVER_NAME is the public DNS name served by nginx. No default domain
# lives in the repo.
# Per-site: SERVER_NAME=<dns-publico-del-sitio> (e.g. SERVER_NAME=zabbix.ejemplo.com.ar)
SERVER_NAME=
# CERT_DIR and ACME_WEBROOT rarely change; uncomment to override the
# compose defaults (/etc/nginx/certs and /var/www/certbot inside nginx).
# CERT_DIR=/etc/nginx/certs
# ACME_WEBROOT=/var/www/certbot
# Published ports and bind IPs (defaults 80/443 on 0.0.0.0).
# Per-site binding examples (uncomment per phase):
# HTTP_BIND_IP=<IP> HTTP_PORT=<port> HTTPS_PORT=443
# Lab default (no bind IP, all interfaces):
# HTTP_PORT=80
# HTTPS_PORT=443
# HTTP_BIND_IP=0.0.0.0
# HTTPS_BIND_IP=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# HTTP_BIND_IP and HTTPS_BIND_IP rarely set in lab; uncomment for per-site IP pinning.
# HTTP_BIND_IP=0.0.0.0
# HTTPS_BIND_IP=0.0.0.0

# --- Tuning Zabbix Server (ajustar según producción) ---
# IMPORTANTE: Los valores por defecto de la imagen oficial son mínimos
# (StartPollers=5, StartPingers=1, CacheSize=32M) y NO alcanzan para
# producción con >50 hosts o mucho SNMP/ICMP. El repo trae un perfil
# Baseline tuning: productive profile (e.g. 100+ hosts / 25k+ items):
# Cada instalación DEBE ajustar según su escala: más hosts/items/SNMP
# requieren más pollers/pingers y caches. Ver docs/instalacion.md § Tuning.
# Si venís de un Zabbix nativo, replicá StartPingers/CacheSize de tu
# zabbix_server.conf previo; no dejes los defaults de Docker.
#
# Example override per-site (Source: zabbix_server.conf CacheSize=1G etc). Uncomment and adapt per client.
#   CacheSize=1G → ZBX_CACHESIZE=1G
#   StartSNMPPollers=5 → ZBX_STARTSNMPPOLLERS=5
#   Timeout=4 → ZBX_TIMEOUT=4
#   StartPingers: scale per host count (see per-client runbook).
# Remaining values are the baseline productive profile unless a per-site override applies.
# For per-site production, uncomment the
# "Example override" lines below and comment the baseline above.
ZBX_STARTPOLLERS=30
ZBX_STARTSNMPPOLLERS=25
# Example override per-site: ZBX_STARTSNMPPOLLERS=5 # Source: zabbix_server.conf StartSNMPPollers=5
ZBX_STARTPINGERS=20
ZBX_STARTPOLLERSUNREACHABLE=5
ZBX_STARTTRAPPERS=10
ZBX_STARTPREPROCESSORS=16
ZBX_STARTDBSYNCERS=8
ZBX_STARTHTTPPOLLERS=2
ZBX_STARTDISCOVERERS=2
ZBX_CACHESIZE=2G
# Example override per-site: ZBX_CACHESIZE=1G # Source: zabbix_server.conf CacheSize=1G
ZBX_HISTORYCACHESIZE=512M
ZBX_HISTORYINDEXCACHESIZE=128M
ZBX_TRENDCACHESIZE=1G
ZBX_TRENDFUNCTIONCACHESIZE=128M
ZBX_VALUECACHESIZE=2G
ZBX_TIMEOUT=4
# Source: zabbix_server.conf Timeout=4
ZBX_UNREACHABLEPERIOD=45
ZBX_UNAVAILABLEDELAY=60
ZBX_UNREACHABLEDELAY=15

# --- Observabilidad hibrida (ADR 0001): Loki + Grafana + Alloy + rsyslog ---
# Solo se usan con docker/docker-compose.observability.yml
# (--profile observability). El stack Zabbix-only ignora estas variables.

# Etiqueta de sitio en todos los streams de Loki.
SITE=lab

# Retencion de Loki (sintaxis de Loki: 168h = 7 dias). Debe cubrir la
# ventana de caida que se quiere sobrevivir; igual criterio que el buffer
# de rsyslog.
LOKI_RETENTION=168h
# Tope de ingesta por sitio (MB/s). Un equipo ruidoso no debe llenar el disco.
LOKI_INGESTION_RATE_MB=4
LOKI_INGESTION_BURST_MB=8
# Limite absoluto de antiguedad de una linea (192h permite la siembra de
# 6 dias del lab). NO es la ventana de drenaje tras una caida: esa es
# ingester.max_chunk_age/2 (1 h por defecto). Ver ADR D3.
LOKI_MAX_BACKLOG=192h

# Receptor syslog: SOLO la IP de gestion. Nunca la WAN ni la IP publica.
# En lab, 127.0.0.1 alcanza; en un sitio, la IP de la interfaz de gestion.
SYSLOG_BIND_IP=127.0.0.1
SYSLOG_PORT=1514
# Dias de buffer de archivo antes de borrar. Si Alloy esta caido mas tiempo,
# se pierden lineas (ver ADR D3).
RSYSLOG_RETENTION_DAYS=7

# Grafana: sin valores por defecto utilizables en produccion.
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
# Usuario Zabbix dedicado, solo lectura, para el datasource.
GF_ZABBIX_USER=grafana-ro
GF_ZABBIX_PASSWORD=
# URL publica de Grafana detras de nginx (per-site en clientes).
GRAFANA_ROOT_URL=http://127.0.0.1/grafana/
# Version del plugin de Zabbix horneada en la imagen.
ZABBIX_PLUGIN_VERSION=6.10.3

# Token de service account de Grafana (rol Viewer) para scripts de lectura
# (digest, preguntar, check_all). Evita usar la cuenta admin en runtime.
# Se crea una vez en el sitio; sin el, los scripts caen a admin con un aviso.
GF_READ_TOKEN=
# Token de API de Zabbix (solo lectura) para el datasource Infinity.
# Se genera en Zabbix: Administracion > Tokens de API (usuario grafana-ro).
ZBX_API_TOKEN=
