POSTGRES_DB=zabbix
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=CAMBIAR

TZ=America/Argentina/Cordoba
SERVER_IP=X.X.X.X

# Directorio base de datos persistentes (postgres).
# Default: /opt/monitoring/data (server). En lab local, apuntar a un directorio propio.
# DATA_DIR=/home/usuario/zbx-in-docker/data
#
# Guia de instalacion y manejo de credenciales: docs/instalacion.md

# TLS / site identity (per-site: each deployment sets its own values).
# SERVER_NAME is the public DNS name served by nginx. No default domain
# lives in the repo. Example (site-a): SERVER_NAME=zabbix.example.com
SERVER_NAME=
# CERT_DIR and ACME_WEBROOT rarely change; uncomment to override the
# compose defaults (/etc/nginx/certs and /var/www/certbot inside nginx).
# CERT_DIR=/etc/nginx/certs
# ACME_WEBROOT=/var/www/certbot
# Published ports (defaults 80/443).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Tuning Zabbix Server (ajustar según producción) ---
# IMPORTANTE: Los valores por defecto de la imagen oficial son mínimos
# (StartPollers=5, StartPingers=1, CacheSize=32M) y NO alcanzan para
# producción con >50 hosts o mucho SNMP/ICMP. El repo trae un perfil
# base productivo probado en site-a (123 hosts / 28k items / 8 cores / 62 GiB).
# Cada instalación DEBE ajustar según su escala: más hosts/items/SNMP
# requieren más pollers/pingers y caches. Ver docs/instalacion.md § Tuning.
# Si venís de un Zabbix nativo, replicá StartPingers/CacheSize de tu
# zabbix_server.conf previo; no dejes los defaults de Docker.
ZBX_STARTPOLLERS=30
ZBX_STARTSNMPPOLLERS=25
ZBX_STARTPINGERS=20
ZBX_STARTPOLLERSUNREACHABLE=5
ZBX_STARTTRAPPERS=10
ZBX_STARTPREPROCESSORS=16
ZBX_STARTDBSYNCERS=8
ZBX_STARTHTTPPOLLERS=2
ZBX_STARTDISCOVERERS=2
ZBX_CACHESIZE=2G
ZBX_HISTORYCACHESIZE=512M
ZBX_HISTORYINDEXCACHESIZE=128M
ZBX_TRENDCACHESIZE=1G
ZBX_TRENDFUNCTIONCACHESIZE=128M
ZBX_VALUECACHESIZE=2G
ZBX_TIMEOUT=4
ZBX_UNREACHABLEPERIOD=45
ZBX_UNAVAILABLEDELAY=60
ZBX_UNREACHABLEDELAY=15
